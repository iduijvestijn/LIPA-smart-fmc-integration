{
    "files.exclude": {
        "**/.venv": true,
        "**/lipa": true,
        "**/*.egg-info": true,
        "**/__pycache__": true,
        "**/.git": true,
        "**/.gitignore": true
        
    },
    "python-envs.defaultEnvManager": "ms-python.python:system",
    "python.defaultInterpreterPath": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
    "python.terminal.activateEnvironment": false,
    "terminal.integrated.profiles.windows": {
        "PowerShell (envlipa)": {
            "path": "${env:WINDIR}\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
            "args": [
                "-ExecutionPolicy",
                "Bypass",
                "-NoExit",
                "-Command",
                "& '${workspaceFolder}\\.venv\\Scripts\\Activate.ps1'; function global:prompt { Write-Host '(envlipa) ' -ForegroundColor Green -NoNewline; \"PS $($executionContext.SessionState.Path.CurrentLocation)> \" }"
            ]
        }
    },
    "terminal.integrated.defaultProfile.windows": "PowerShell (envlipa)"
}